# Validakey API root.
VALIDAKEY_BASE_URL=https://example.validakey.host/v1

# Your Validakey account UUID.
VALIDAKEY_API_UUID=your-account-uuid-here

# The application UUID issued by Validakey for this app. This keys the instance
# handshake, so treat it as a secret rather than a label.
VALIDAKEY_USER_APP_ID=your-user-app-id-here

# Optional in this library. The handshake requires a subject; when this is
# empty the client assigns a random Subject ID and stores it with the instance.
VALIDAKEY_SUBJECT=

# Optional. Overrides the auto-detected host name, which forms part of the
# machine fingerprint.
VALIDAKEY_HOST=

# Optional, and usually best left empty. Your account private key, used only by
# the account endpoints. Everything to do with licenses — minting, validating,
# renewing, revoking, and collecting your customer's card — is authenticated by
# the instance handshake and needs no key at all. Never ship this in software
# you distribute.
VALIDAKEY_API_PKEY=

# Optional. Request timeout in seconds; defaults to 30.
VALIDAKEY_TIMEOUT=30
